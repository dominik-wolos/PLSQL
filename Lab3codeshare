    PROCEDURE verifyExamCount(studentId NUMBER, subjectId NUMBER) IS
        examCount NUMBER;
    BEGIN
        SELECT COUNT(*) INTO examCount FROM EGZAMINY x WHERE x.ID_STUDENT = studentId AND x.ID_PRZEDMIOT = subjectId;

        IF (examCount < 3) THEN
            RETURN;
